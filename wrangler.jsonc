{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qq-msgbot",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "kv_namespaces": [
    {
      "binding": "BOT_KV"
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qq-msgbot-db"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ]
}
